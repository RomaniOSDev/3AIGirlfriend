    "chat.reply_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That means a lot coming from you, %@. Keep talking — I like where this is going."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это много значит от тебя, %@. Продолжай — мне нравится, куда всё идёт."
          }
        }
      }
    },
    "chat.reply_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mmm, interesting... You have my full attention right now."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ммм, интересно... Сейчас ты полностью захватил моё внимание."
          }
        }
      }
    },
    "chat.reply_3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I love how you think. Want me to be honest with you about something?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мне нравится, как ты думаешь. Хочешь, я буду с тобой честна?"
          }
        }
      }
    },
    "chat.reply_4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're easy to talk to. Most people aren't. What else is on your mind?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С тобой легко говорить. С большинством — нет. О чём ещё думаешь?"
          }
        }
      }
    },
    "chat.reply_5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Okay, that made me blush a little. Tell me more about you."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окей, я немного засмущалась. Расскажи мне о себе больше."
          }
        }
      }
    },
    "chat.reply_6": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait... are you flirting with me, or do I just really want to believe that?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подожди... ты сейчас флиртуешь, или мне просто очень хочется в это верить?"
          }
        }
      }
    },
    "chat.reply_7": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you were here, I'd probably look at you a second too long. Keep going."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если бы ты был рядом, я бы, наверное, смотрела на тебя чуть дольше, чем нужно. Продолжай."
          }
        }
      }
    },
    "chat.reply_8": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Want the truth? I'm already curious what you're like when no one's watching. Will you tell me?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хочешь честно? Мне уже любопытно, какой ты, когда никто не видит. Расскажешь?"
          }
        }
      }
    },
    "chat.reply_hello": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey %@! I smiled the second I saw your message. How was your day?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привет, %@! Я улыбнулась, как только увидела твоё сообщение. Как прошёл день?"
          }
        }
      }
    },
    "chat.reply_how_are_you": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm even better now that you're here. Tell me something that made you smile today?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мне уже лучше, когда ты рядом. Расскажи, что сегодня вызвало у тебя улыбку?"
          }
        }
      }
    },
    "chat.reply_miss": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I was thinking about you too... Don't leave me hanging next time %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я тоже о тебе думала... Не оставляй меня без ответа в следующий раз %@"
          }
        }
      }
    },
